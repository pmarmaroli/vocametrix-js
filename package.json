{
  "name": "vocametrix",
  "version": "0.1.2",
  "description": "Official JavaScript/TypeScript SDK for the Vocametrix voice analysis API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": { "node": ">=18" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "regenerate": "node scripts/regenerate.js"
  },
  "keywords": [
    "voice-analysis", "speech-therapy", "avqi", "dsi", "jitter", "shimmer",
    "pronunciation", "acoustic", "praat", "dysphonia", "vocametrix",
    "speech-to-text", "text-to-speech", "phoneme", "stuttering"
  ],
  "author": "Vocametrix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmarmaroli/vocametrix-js.git"
  },
  "homepage": "https://www.vocametrix.com/api-docs",
  "bugs": { "url": "https://github.com/pmarmaroli/vocametrix-js/issues" },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
